Import('*')

from itertools import product
from source.lib.python.config_loaders import LoadPipelineInputs

CONFIG = LoadPipelineInputs("../../../source/lib/config/pipeline_inputs.json")
IMPORTANCE_TYPES  = CONFIG["importance_types"]["run"]
ROLLING_PERIODS   = [f"rolling{p}" for p in CONFIG["rolling_periods"]["run"]]
QUALIFIED_SAMPLES = CONFIG["qualified_samples"]["run"]
CONTROL_GROUPS    = CONFIG["control_groups"]["run"]
OUTCOME_SAMPLES   = CONFIG["outcome_samples"]["run"]
ROLLING_PERIOD    = f"rolling{CONFIG['rolling_periods']['run'][0]}"

candidate_sources = [
    '#source/derived/analysis_panel/build_candidate_panel.py',
    '#source/derived/analysis_panel/panel_filters.py',
    '#source/lib/python/config_loaders.py',
    '#source/lib/JMSLab/SaveData.py',
    '#source/lib/config/pipeline_inputs.json',
]

for importance_type in IMPORTANCE_TYPES:
    for rolling_period in ROLLING_PERIODS:
        panel_source = f'#drive/output/derived/org_outcomes_practices/org_panel/{importance_type}/{rolling_period}/panel.parquet'
        candidate_targets = [
            f'#output/derived/analysis_panel/candidate/{importance_type}/{rolling_period}/{qualified_sample}/{control_group}/{f}'
            for qualified_sample in QUALIFIED_SAMPLES
            for control_group in CONTROL_GROUPS
            for f in ["panel.parquet", "panel.log"]
        ]
        env.Python(candidate_targets, candidate_sources + [panel_source],
                   CL_ARG=[f'CL_IMPORTANCE_TYPE={importance_type}', f'CL_ROLLING_PERIOD={rolling_period}'])

combos = list(product(IMPORTANCE_TYPES, QUALIFIED_SAMPLES, CONTROL_GROUPS))

analysis_sources = [
    '#source/derived/analysis_panel/build_analysis_panel.py',
    '#source/derived/analysis_panel/panel_filters.py',
    '#source/lib/python/pull_request_stages.py',
    '#source/lib/python/data_utils.py',
    '#source/lib/python/config_loaders.py',
    '#source/lib/python/repo_utils.py',
    '#source/derived/org_outcomes_practices/helpers.py',
    '#source/lib/JMSLab/SaveData.py',
    '#source/lib/config/global_settings.json',
    '#source/lib/config/pipeline_inputs.json',
    '#source/lib/config/analysis_parameters.json',
    '#source/lib/pc_groups.json',
    '#output/derived/hashes/repo_actions.txt',
    '#output/derived/create_bot_list/bot_list.csv',
]
for importance_type, qualified_sample, control_group in combos:
    candidate_base = f'#output/derived/analysis_panel/candidate/{importance_type}/{ROLLING_PERIOD}/{qualified_sample}/{control_group}'
    analysis_sources.append(f'{candidate_base}/panel.parquet')

analysis_files = [
    "panel.parquet", "panel.log",
    "pc_score_metadata.csv", "pc_score_metadata.log",
    "pc_score_excluded_vars.csv", "pc_score_excluded_vars.log",
    "pc_score_columns.json",
]
analysis_targets = [
    f'#output/derived/analysis_panel/{outcome_sample}/{importance_type}/{ROLLING_PERIOD}/{qualified_sample}/{control_group}/{panel_file}'
    for outcome_sample in OUTCOME_SAMPLES
    for importance_type, qualified_sample, control_group in combos
    for panel_file in analysis_files
]
env.Python(analysis_targets, analysis_sources)
