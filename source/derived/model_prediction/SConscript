Import('*')

from itertools import product
from source.lib.python.config_loaders import LoadPipelineInputs, LoadPaperSettings

CONFIG         = LoadPipelineInputs("../../../source/lib/config/pipeline_inputs.json")
PAPER_SETTINGS = LoadPaperSettings("../../../source/lib/config/paper_settings.json")

importance_types  = CONFIG["importance_types"]["run"]
rolling_period    = f"rolling{CONFIG['rolling_periods']['run'][0]}"
qualified_samples = CONFIG["qualified_samples"]["run"]
control_groups    = CONFIG["control_groups"]["run"]

combos = list(product(importance_types, qualified_samples, control_groups))

script_deps = [
    '#source/derived/model_prediction/build_event_time_member_panel.py',
    '#source/derived/org_outcomes_practices/helpers.py',
    '#source/lib/python/config_loaders.py',
    '#source/lib/python/data_utils.py',
    '#source/lib/python/repo_utils.py',
    '#source/lib/python/filesystem_utils.py',
    '#source/lib/JMSLab/SaveData.py',
    '#source/lib/config/global_settings.json',
    '#source/lib/config/pipeline_inputs.json',
    '#output/derived/hashes/repo_actions.txt',
    '#output/derived/create_bot_list/bot_list.csv',
]

panel_sources = [
    f'#output/derived/analysis_panel/{importance_type}/{rolling_period}/{qualified_sample}/{control_group}/panel.parquet'
    for importance_type, qualified_sample, control_group in combos
]

target = [
    '#output/derived/hashes/event_time_member_panel.txt',
]
source = script_deps + panel_sources
env.Python(target, source)

from source.lib.python.config_loaders import LoadGlobals
MODEL_PREDICTION_CONFIG = LoadGlobals("../../../source/lib/config/model_prediction.json")
model_variant      = MODEL_PREDICTION_CONFIG["variants"]["run"][0]
model_distribution = MODEL_PREDICTION_CONFIG["distribution_types"]["run"][0]
model_estimation   = MODEL_PREDICTION_CONFIG["member_probability_estimation"]["run"][0]
distribution_params_source = (
    f'#output/analysis/model_prediction/{model_variant}/{model_distribution}/parameters/{model_estimation}/'
    f'{PAPER_SETTINGS["primary_importance_type"]}/{PAPER_SETTINGS["primary_qualified_sample"]}/'
    f'{PAPER_SETTINGS["primary_control_group"]}/distribution_params.parquet'
)

source = [
    '#source/derived/model_prediction/compute_overdispersion.py',
    '#source/lib/python/config_loaders.py',
    '#source/lib/JMSLab/autofill.py',
    '#source/lib/config/model_prediction.json',
    '#source/lib/config/paper_settings.json',
    distribution_params_source,
]

env.Python(
    ['#output/autofill/overdispersion_autofill.tex'],
    source,
)
