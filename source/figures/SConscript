Import('*')
from source.lib.python.config_loaders import LoadPaperSettings, LoadGlobals

CONFIG = LoadPaperSettings("../../source/lib/config/paper_settings.json")
PRIMARY_OUTCOME_SAMPLE = CONFIG["primary_outcome_sample"]
PRIMARY_SPEC = "/".join([
    CONFIG["primary_importance_type"],
    CONFIG["primary_rolling_label"],
    CONFIG["primary_qualified_sample"],
    CONFIG["primary_control_group"],
])

EVENT_STUDY_DIR = f'#output/analysis/event_study/{PRIMARY_OUTCOME_SAMPLE}/{PRIMARY_SPEC}'
FOREST_DIR = f'#output/analysis/event_study_forest/{PRIMARY_OUTCOME_SAMPLE}/{PRIMARY_SPEC}'
ANALYZE_FOREST_DIR = f'#output/analysis/analyze_forest/{PRIMARY_SPEC}/norm'

# Model outputs carry no rolling label, unlike PRIMARY_SPEC.
MODEL_PREDICTION_CONFIG = LoadGlobals("../../source/lib/config/model_prediction.json")
MODEL_OUTCOME_SAMPLE      = MODEL_PREDICTION_CONFIG["outcome_samples"]["run"][0]
MODEL_DISTRIBUTION = MODEL_PREDICTION_CONFIG["distribution_types"]["run"][0]
MODEL_ESTIMATION   = MODEL_PREDICTION_CONFIG["member_probability_estimation"]["run"][0]
MODEL_SPEC = "/".join([
    CONFIG["primary_importance_type"],
    CONFIG["primary_qualified_sample"],
    CONFIG["primary_control_group"],
])
MODEL_FIT_DIR         = f'#output/analysis/model_prediction/{MODEL_OUTCOME_SAMPLE}/{MODEL_DISTRIBUTION}/evaluation/{MODEL_ESTIMATION}/{MODEL_SPEC}'
MODEL_EVENT_STUDY_DIR = f'#output/analysis/model_event_study/{MODEL_OUTCOME_SAMPLE}/{MODEL_DISTRIBUTION}/{MODEL_ESTIMATION}/{MODEL_SPEC}'

OUTCOMES = ['pull_request_opened', 'pull_request_merged', 'overall_new_release_count']

target = ['#source/figures/social_network.tex']
source = [
    '#source/figures/dev_pipeline.tikz',
    '#source/raw/gephi/boto_2020_1.png',
]
env.Depends(target=target, dependency=source)

target = ['#source/figures/event_study.tex']
source = [
    f'{EVENT_STUDY_DIR}/full_sample/norm/{outcome}.png'
    for outcome in OUTCOMES
]
env.Depends(target=target, dependency=source)

target = ['#source/figures/event_study_collab.tex']
source = [
    f'{EVENT_STUDY_DIR}/pc_score/norm/collaboration_{outcome}_pc_score_split.png'
    for outcome in OUTCOMES
]

env.Depends(target=target, dependency=source)

target = ['#source/figures/event_study_practice_categories_knowledge_quality.tex']
source = [
    f'{EVENT_STUDY_DIR}/pc_score/norm/{group}_{outcome}_pc_score_split.png'
    for group in ['knowledge_level', 'discussion_quality']
    for outcome in OUTCOMES
]
env.Depends(target=target, dependency=source)

target = ['#source/figures/event_study_practice_categories_investment_routines.tex']
source = [
    f'{EVENT_STUDY_DIR}/pc_score/norm/{group}_{outcome}_pc_score_split.png'
    for group in ['investment_in_new_talent', 'problem_solving_routines']
    for outcome in OUTCOMES
]
env.Depends(target=target, dependency=source)

target = ['#source/figures/event_study_other_practices.tex']
source = [
    '#source/figures/event_study_practice_categories_knowledge_quality.tex',
    '#source/figures/event_study_practice_categories_investment_routines.tex',
]
env.Depends(target=target, dependency=source)

target = ['#source/figures/event_study_forest_coarse.tex']
source = [
    f'{FOREST_DIR}/pc_score_binary/split_full_avg/norm/{outcome}_observed.png'
    for outcome in OUTCOMES
]
env.Depends(target=target, dependency=source)

target = ['#source/figures/event_study_forest_continuous.tex']
source = [
    f'{FOREST_DIR}/pc_score/split_full_avg/norm/{outcome}_observed.png'
    for outcome in OUTCOMES
]
env.Depends(target=target, dependency=source)

target = ['#source/figures/event_study_dynamics.tex']
source = [
    f'{FOREST_DIR}/pc_score/split_period5/norm/{outcome}_observed.png'
    for outcome in OUTCOMES
]
env.Depends(target=target, dependency=source)

target = ['#source/figures/forest_characteristics.tex']
source = [
    f'{ANALYZE_FOREST_DIR}/variable_importance.tex',
    f'{ANALYZE_FOREST_DIR}/pc_score_correlation_heatmap.png',
]
env.Depends(target=target, dependency=source)

target = ['#source/figures/pc_score_combo.tex']
source = [
    f'{ANALYZE_FOREST_DIR}/pc_score_combo_high_low_grid.png',
]
env.Depends(target=target, dependency=source)

MODEL_FIT_FIGURES = [
    ('model_fit_insample',      'signed',  'pre_period_fit_insample'),
    ('model_fit_post',          'signed',  'post_period_fit'),
    ('model_fit_insample_loo',  'signed',  'pre_period_fit_leaveoneout'),
    ('model_fit_insample_q',    'squared', 'pre_period_fit_insample'),
    ('model_fit_loo_q',         'squared', 'pre_period_fit_leaveoneout'),
    ('model_fit_post_q',        'squared', 'post_period_fit'),
]
for figure_name, kind, stem in MODEL_FIT_FIGURES:
    env.Depends(
        target=[f'#source/figures/{figure_name}.tex'],
        dependency=[
            f'{MODEL_FIT_DIR}/panels/{kind}/{stem}.png',
            f'#output/tables/model_fit_{kind}_{stem}.tex',
        ],
    )

MAIN_ES_OUTCOMES = ['pull_request_opened', 'pull_request_reviewed', 'pull_request_merged']
PATH_ES_OUTCOMES = ['pull_request_merged_direct', 'pull_request_merged_after_review']
MODEL_EVENT_STUDY_FIGURES = [
    ('model_departure_effects',            'bands/norm',              MAIN_ES_OUTCOMES),
    ('model_departure_effects_paths',      'bands/norm',              PATH_ES_OUTCOMES),
    ('model_departure_resilience',         'resilience/pc_score/norm', MAIN_ES_OUTCOMES),
    ('model_departure_resilience_paths',   'resilience/pc_score/norm', PATH_ES_OUTCOMES),
]
for figure_name, subdir, es_outcomes in MODEL_EVENT_STUDY_FIGURES:
    env.Depends(
        target=[f'#source/figures/{figure_name}.tex'],
        dependency=[f'{MODEL_EVENT_STUDY_DIR}/{subdir}/{outcome}.png' for outcome in es_outcomes],
    )
