]

figure_asset_sources += [
    f'{EVENT_STUDY_DIR}/full_sample/norm/{outcome}.png'
    for outcome in OUTCOMES
]

for groups in [
    ['collaboration'],
    ['knowledge_level', 'discussion_quality'],
    ['investment_in_new_talent', 'problem_solving_routines'],
]:
    figure_asset_sources += [
        f'{EVENT_STUDY_DIR}/pc_score/norm/{group}_{outcome}_pc_score_split.png'
        for group in groups
        for outcome in OUTCOMES
    ]

for split_dir in [
    'pc_score_binary/split_full_avg',
    'pc_score/split_full_avg',
    'pc_score/split_period5',
]:
    figure_asset_sources += [
        f'{FOREST_DIR}/{split_dir}/norm/{outcome}_observed.png'
        for outcome in OUTCOMES
    ]

MODEL_FIT_STEMS = ['pre_period_fit_insample', 'pre_period_fit_leaveoneout', 'post_period_fit']
figure_asset_sources += [
    f'{MODEL_FIT_DIR}/panels/{kind}/{stem}.png'
    for kind in ['signed', 'squared']
    for stem in MODEL_FIT_STEMS
]

MODEL_ES_OUTCOMES = [
    'pull_request_opened', 'pull_request_reviewed', 'pull_request_merged',
    'pull_request_merged_direct', 'pull_request_merged_after_review',
]
figure_asset_sources += [
    f'{MODEL_EVENT_STUDY_DIR}/{group}/norm/{outcome}.png'
    for group in ['bands', 'resilience/pc_score']
    for outcome in MODEL_ES_OUTCOMES
]

target = ['#output/paper/main.pdf']
source = [
    '#source/paper/main.tex',
    '#source/paper/references.bib',
    '#source/paper/aea.bst',
] + figure_sources + figure_asset_sources + autofill_sources + table_sources
env.Latex(target, source)
