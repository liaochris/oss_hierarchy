{
  "github_outcomes": {
    "run": [
      "pull_request_opened",
      "pull_request_merged",
      "pull_request_reviewed",
      "pull_request_merged_direct",
      "pull_request_merged_after_review"
    ],
    "extended": [
      "issue_opened",
      "issue_closed",
      "pull_request_closed"
    ]
  },
  "pull_request_rates": {
    "run": [
      "merge_rate",
      "review_rate",
      "direct_merge_rate",
      "reviewed_merge_rate"
    ]
  },
  "downstream_outcomes": {
    "run": [
      "overall_new_release_count"
    ],
    "extended": [
      "major_minor_release_count",
      "num_downloads",
      "major_new_release_count",
      "patch_new_release_count",
      "other_new_release_count",
      "major_minor_patch_release_count"
    ]
  }
}
