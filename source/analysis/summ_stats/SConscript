Import('*')

from source.lib.python.config_loaders import LoadGlobalSettings, LoadPaperSettings, LoadPipelineInputs
from source.lib.python.repo_utils import MakeRepoNameSafe

globals_data = LoadGlobalSettings("../../../source/lib/config/global_settings.json")
pipeline_cfg = LoadPipelineInputs("../../../source/lib/config/pipeline_inputs.json")
paper_cfg = LoadPaperSettings("../../../source/lib/config/paper_settings.json")
reference_repo = globals_data['reference_github_repo']
reference_repo_safe_name = MakeRepoNameSafe(reference_repo)
importance_type = paper_cfg["primary_importance_type"]
rolling_label = paper_cfg["primary_rolling_label"]
control_group = paper_cfg["primary_control_group"]
outcome_sample = paper_cfg["primary_outcome_sample"]
primary_qualified_sample = paper_cfg["primary_qualified_sample"]
pc_groups = ["collaboration", "knowledge_level", "discussion_quality",
             "investment_in_new_talent", "problem_solving_routines"]
exact_samples = sorted(
    [s for s in pipeline_cfg["qualified_samples"]["run"] if "_" not in s],
    key=lambda s: int(s.removeprefix("exact"))
)

summary_source = [
    '#source/analysis/summ_stats/create_project_summary.py',
    '#source/lib/config/global_settings.json',
    '#source/lib/config/pipeline_inputs.json',
    '#source/lib/config/analysis_parameters.json',
    '#source/lib/config/importance_specifications.json',
    '#source/lib/config/paper_settings.json',
    '#source/lib/config/feature_variables.json',
    '#source/lib/pc_groups.json',
    '#output/scrape/pypi_downloads/popular_python_packages.csv',
    '#output/scrape/pypi_site_info/linked_pypi_github.csv',
    '#output/scrape/extract_github_data/repo_id_history_final.csv',
    f'#drive/output/scrape/extract_github_data/repo_level_data/issue/{reference_repo_safe_name}.parquet',
    f'#drive/output/scrape/extract_github_data/repo_level_data/pr/{reference_repo_safe_name}.parquet',
    '#output/derived/graph_structure/exported_graphs_log.csv',
    f'#drive/output/derived/org_outcomes_practices/org_panel/{importance_type}/{rolling_label}/panel.parquet',
]
summary_source += [
    f'#output/derived/analysis_panel/{outcome_sample}/{importance_type}/{rolling_label}/{sample}/{control_group}/panel.parquet'
    for sample in exact_samples
]
summary_source.append(
    f'#output/derived/analysis_panel/{outcome_sample}/{importance_type}/{rolling_label}/{primary_qualified_sample}/{control_group}/pc_score_metadata.csv'
)
summary_target = [
    '#output/analysis/summ_stats/project_summary.parquet',
    '#output/analysis/summ_stats/project_summary.log',
    '#output/analysis/summ_stats/summary_table.txt',
    '#output/autofill/config_autofill.tex',
    '#output/autofill/panel_autofill.tex',
    '#output/autofill/pc_autofill.tex',
]
summary_target += [f'#output/derived/analysis_panel/pc_loadings_{group}.txt' for group in pc_groups]
env.Python(summary_target, summary_source)

IMPORTANCE_TYPES   = pipeline_cfg["importance_types"]["run"]
ROLLING_PERIODS    = [f"rolling{p}" for p in pipeline_cfg["rolling_periods"]["run"]]
QUALIFIED_SAMPLES  = pipeline_cfg["qualified_samples"]["run"]
CONTROL_GROUPS     = pipeline_cfg["control_groups"]["run"]
AGGREGATED_SAMPLES = {"exact_1_2": ["exact1", "exact2"]}

SUMM_SHARED_LIBS = [
    '#source/analysis/summ_stats/helpers.R',
    '#source/lib/R/config_loaders.R',
    '#source/lib/R/analysis_utils.R',
    '#source/lib/R/constants.R',
    '#source/lib/config/pipeline_inputs.json',
    '#source/lib/config/feature_variables.json',
    '#source/lib/config/outcome_variables.json',
    '#source/lib/config/analysis_parameters.json',
    '#source/lib/config/plotting.json',
]

combos = [(importance_type, rolling_period, qualified_sample, control_group)
          for importance_type in IMPORTANCE_TYPES for rolling_period in ROLLING_PERIODS
          for qualified_sample in QUALIFIED_SAMPLES for control_group in CONTROL_GROUPS]

panel_inputs = list(dict.fromkeys(
    f'#output/derived/analysis_panel/{outcome_sample}/{importance_type}/{rolling_period}/{sub_sample}/{control_group}/panel.parquet'
    for importance_type, rolling_period, qualified_sample, control_group in combos
    for sub_sample in AGGREGATED_SAMPLES.get(qualified_sample, [qualified_sample])
))

def SummOutdir(importance_type, rolling_period, qualified_sample, control_group):
    return f'#output/analysis/summ_stats/{importance_type}/{rolling_period}/{qualified_sample}/{control_group}/raw'

outcome_targets = [f'{SummOutdir(*c)}/outcome_summary.txt' for c in combos]
env.R(outcome_targets,
      ['#source/analysis/summ_stats/outcome_diagnostics.R'] + SUMM_SHARED_LIBS + panel_inputs)

timeline_targets = [f'{SummOutdir(*c)}/repo_count_timeline.png' for c in combos]
env.R(timeline_targets,
      ['#source/analysis/summ_stats/org_timeline.R'] + SUMM_SHARED_LIBS + panel_inputs)
