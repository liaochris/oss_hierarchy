Import('*')

from itertools import product
from source.lib.python.config_loaders import LoadPipelineInputs, LoadGlobals

CONFIG                  = LoadPipelineInputs("../../../source/lib/config/pipeline_inputs.json")
MODEL_PREDICTION_CONFIG = LoadGlobals("../../../source/lib/config/model_prediction.json")

importance_types = CONFIG["importance_types"]["run"]
rolling_label    = f"rolling{CONFIG['rolling_periods']['run'][0]}"
control_groups   = CONFIG["control_groups"]["run"]
outcome_sample          = MODEL_PREDICTION_CONFIG["outcome_samples"]["run"][0]
distribution     = MODEL_PREDICTION_CONFIG["distribution_types"]["run"][0]
estimation       = "pooled"

non_aggregated_samples  = ["exact1", "exact2"]
figure_samples          = ["exact1", "exact2", "exact_1_2"]
outcomes                = ["pull_request_merged", "pull_request_opened"]
norm_labels             = ["norm", "raw"]
covar_types             = CONFIG["feature_sets"]["run"]
forest_training_outcome = CONFIG["forest_training_outcome"]
latent_flow_outcome     = "pull_request_opened"

script_deps = [
    '#source/analysis/model_event_study/estimate_model_event_study.R',
    '#source/lib/R/config_loaders.R',
    '#source/lib/R/analysis_utils.R',
    '#source/lib/R/event_study_helpers.R',
    '#source/lib/R/constants.R',
    '#source/lib/R/pc_groups.R',
    '#source/lib/config/pipeline_inputs.json',
    '#source/lib/config/analysis_parameters.json',
    '#source/lib/config/paper_settings.json',
    '#source/lib/config/outcome_variables.json',
    '#source/lib/config/feature_variables.json',
    '#source/lib/config/plotting.json',
    '#source/lib/config/global_settings.json',
    '#source/lib/config/model_prediction.json',
    '#output/derived/hashes/event_time_member_panel.txt',
]

panel_sources = [
    f'#output/derived/analysis_panel/{outcome_sample}/{importance_type}/{rolling_label}/{qualified_sample}/{control_group}/panel.parquet'
    for importance_type, control_group in product(importance_types, control_groups)
    for qualified_sample in non_aggregated_samples
]
draw_sources = [
    f'#drive/output/analysis/model_prediction/{outcome_sample}/{distribution}/draws/{estimation}/{importance_type}/{qualified_sample}/{control_group}/raw_draws.parquet'
    for importance_type, control_group in product(importance_types, control_groups)
    for qualified_sample in non_aggregated_samples
]
forest_sources = [
    f'#output/analysis/event_study_forest/{outcome_sample}/{importance_type}/{rolling_label}/{qualified_sample}/{control_group}/{covar_type}/{norm_label}/{forest_training_outcome}_repo_att_event_study_forest.parquet'
    for importance_type, control_group in product(importance_types, control_groups)
    for qualified_sample in non_aggregated_samples
    for covar_type in covar_types
    for norm_label in norm_labels
]

target = ['#output/analysis/model_event_study/band_estimates.csv',
          '#output/analysis/model_event_study/band_estimates.log',
          '#output/analysis/model_event_study/resilience_band_estimates.csv',
          '#output/analysis/model_event_study/resilience_band_estimates.log',
          '#output/analysis/model_event_study/actual_treated_model_control_band_estimates.csv',
          '#output/analysis/model_event_study/actual_treated_model_control_band_estimates.log']
for importance_type, control_group in product(importance_types, control_groups):
    for qualified_sample in figure_samples:
        base = f'#output/analysis/model_event_study/{outcome_sample}/{distribution}/{estimation}/{importance_type}/{qualified_sample}/{control_group}'
        for norm_label in norm_labels:
            target += [f'{base}/actual_treated_model_control/{norm_label}/{latent_flow_outcome}.png']
            for outcome in outcomes:
                target += [f'{base}/bands/{norm_label}/{outcome}.png']
                for covar_type in covar_types:
                    target += [f'{base}/resilience/{covar_type}/{norm_label}/{outcome}.png']

source = script_deps + panel_sources + draw_sources + forest_sources
env.R(target, source)
